# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: unlocks the RLS-locked `credentials` table
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: AES-256-GCM key for stored mail passwords (64 hex chars)
TRIA_ENC_KEY=

# Mail sign-in (OAuth). Required for Microsoft 365 / Google Workspace accounts,
# which block password logins. Redirect URI to register with each provider:
#   https://<your-domain>/api/oauth/microsoft/callback
#   https://<your-domain>/api/oauth/google/callback
# Registered ONCE by whoever runs Tria — not per user. Every account then signs
# in the way Spark/Outlook do. PKCE is used, so the secret is optional: a public
# client registration needs only the ID.
# Microsoft — Entra admin centre → App registrations → New registration.
# Accounts type: "any organizational directory + personal" (multi-tenant).
# Delegated permissions: IMAP.AccessAsUser.All, SMTP.Send, offline_access, email
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Google — Cloud console → APIs & Services → Credentials → OAuth client ID (Web)
# Scope: https://mail.google.com/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google (autofill / Places / Maps)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Anthropic (AI pane)
ANTHROPIC_API_KEY=

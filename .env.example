# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: unlocks the RLS-locked `credentials` table
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: AES-256-GCM key for stored mail passwords (64 hex chars)
TRIA_ENC_KEY=

# Mail sign-in (OAuth). Required for Microsoft 365 / Google Workspace accounts,
# which block password logins. Redirect URI to register with each provider:
#   https://<your-domain>/api/oauth/microsoft/callback
#   https://<your-domain>/api/oauth/google/callback
# Registered ONCE by whoever runs Tria — not per user. Every account then signs
# in the way Spark/Outlook do. PKCE is always used, but a redirect URI registered
# under the "Web" platform is a confidential client, so Microsoft/Google still
# require the SECRET at token exchange (AADSTS7000218 if it is missing). Only a
# public-client registration works with the ID alone.
# Microsoft — Entra admin centre → App registrations → New registration.
# Accounts type: "any organizational directory + personal" (multi-tenant).
# Delegated permissions: IMAP.AccessAsUser.All, SMTP.Send, offline_access, email
# plus Microsoft Graph -> Mail.Send. Graph is what actually sends: a tenant with
# SMTP AUTH disabled (Microsoft's default since 2020) rejects every SMTP login
# with 535 5.7.139 no matter how valid the token is, and Graph is unaffected.
# Existing accounts must be disconnected and signed in again to consent to it.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Google — Cloud console → APIs & Services → Credentials → OAuth client ID (Web)
# Scope: https://mail.google.com/ is a RESTRICTED scope. Until the app passes
# Google verification only accounts listed as Test users on the OAuth consent
# screen can grant it, and they see an "unverified app" warning first.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google (autofill / Places / Maps)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Anthropic (AI pane)
ANTHROPIC_API_KEY=

# ── OpenRouter (alternative AI provider for the routes under /api/ai) ─
# Both AI keys are OPTIONAL here: Settings -> AI stores them in the app,
# verified against the provider first and effective without a redeploy, and a
# stored key takes precedence over these. These stay as the fallback.
# The AI features prefer ANTHROPIC_API_KEY (native Claude API) and fall
# through to OPENROUTER_API_KEY when that key is missing or rejected — set
# both and a dead key stops taking the AI down. Get a key at
# https://openrouter.ai/keys, and check a deployed one with
# `curl https://<deployment>/api/ai/health`.
# Paste the key alone: no quotes, no "Bearer " prefix, no trailing newline.
# (They are stripped before use, but they are why a good key 401s elsewhere.)
OPENROUTER_API_KEY=
# Optional: force one model (OpenRouter id). It is tried first, ahead of the
# built-in chain — anthropic/claude-haiku-4.5 (fast and a fraction of a cent),
# then the free tiers nvidia/nemotron-3-ultra-550b-a55b:free and
# openrouter/free as the no-cost fallback.
OPENROUTER_MODEL=
